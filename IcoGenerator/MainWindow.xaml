<Window x:Class="IcoGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:converters="clr-namespace:IcoGenerator.Converters"
        xmlns:controls="clr-namespace:IcoGenerator.Controls"
        mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="Ico Generator" Height="900" Width="1260" MinHeight="680" MinWidth="1040"
        Icon="pack://application:,,,/icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{StaticResource WindowBgBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBool"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVis"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrush"/>
        <converters:NullToVisibilityConverter x:Key="NullToVis"/>
        <converters:BackdropToBrushConverter x:Key="BackdropToBrush"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="RootBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="Margin" Value="8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SwitchRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SliderLabelRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource RootBorderStyle}" Background="{StaticResource WindowBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= Title bar ================= -->
            <Grid Grid.Row="0" Background="{StaticResource Panel1Brush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" IsHitTestVisible="False">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource AccentGradientBrush}" VerticalAlignment="Center">
                        <TextBlock Text="I" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ico Generator" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0,5 H10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2" Width="10" Height="10" Stretch="None"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestoreButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid Width="10" Height="10">
                            <Rectangle x:Name="MaximizeIcon" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2"/>
                            <Canvas x:Name="RestoreIcon" Visibility="Collapsed">
                                <Rectangle Canvas.Left="2" Canvas.Top="0" Width="8" Height="8" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.1"/>
                                <Rectangle Canvas.Left="0" Canvas.Top="2" Width="8" Height="8" Fill="{StaticResource Panel1Brush}" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.1"/>
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}" Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2" Width="10" Height="10" Stretch="None"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= Body ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ========== Left: design controls ========== -->
                <Border Grid.Column="0" Background="{StaticResource Panel1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,16,14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Design" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="🎲 Surprise me" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7" FontSize="12"
                                        Command="{Binding RandomizeCommand}" Margin="0,0,6,0"/>
                                <Button Content="↺ Reset" Style="{StaticResource GhostIconButtonStyle}" Padding="10,7" FontSize="12"
                                        Command="{Binding ResetCommand}"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Style="{StaticResource CardScrollViewerStyle}" Padding="18,4,14,18">
                            <StackPanel>

                                <!-- ===================== Text ===================== -->
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Text" Style="{StaticResource SectionHeaderStyle}"/>

                                        <TextBox Text="{Binding Design.Text, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBoxStyle}" MaxLength="48" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,8,0"
                                                      ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding Design.FontFamily}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="13"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ToggleButton Content="B" Style="{StaticResource SegmentToggleButtonStyle}" Width="30"
                                                              IsChecked="{Binding Design.Bold}" Margin="0,0,4,0"/>
                                                <ToggleButton Content="I" Style="{StaticResource SegmentToggleButtonStyle}" Width="30" FontStyle="Italic"
                                                              IsChecked="{Binding Design.Italic}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Style="{StaticResource SliderLabelRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="FONT SIZE" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Design.FontSize, StringFormat={}{0:F0}px}" Style="{StaticResource FieldValueStyle}"/>
                                        </Grid>
                                        <Slider Minimum="10" Maximum="220" Value="{Binding Design.FontSize}" Style="{StaticResource ModernSliderStyle}" Margin="0,0,0,12"/>

                                        <Grid Style="{StaticResource SwitchRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Uppercase text" Style="{StaticResource RowLabelStyle}"/>
                                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding Design.UppercaseText}"/>
                                        </Grid>

                                        <Grid Style="{StaticResource SwitchRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Auto-contrast color" Style="{StaticResource RowLabelStyle}"/>
                                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding Design.AutoContrastText}"/>
                                        </Grid>

                                        <Grid Style="{StaticResource SwitchRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Text color" Style="{StaticResource RowLabelStyle}"
                                                       IsEnabled="{Binding Design.AutoContrastText, Converter={StaticResource InverseBool}}"/>
                                            <controls:ColorPickerButton Grid.Column="1" SelectedColor="{Binding Design.TextColor}"
                                                                          IsEnabled="{Binding Design.AutoContrastText, Converter={StaticResource InverseBool}}"/>
                                        </Grid>

                                        <Grid Style="{StaticResource SliderLabelRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="TEXT OPACITY" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Design.TextOpacity, StringFormat={}{0:P0}}" Style="{StaticResource FieldValueStyle}"/>
                                        </Grid>
                                        <Slider Minimum="0.1" Maximum="1" SmallChange="0.05" Value="{Binding Design.TextOpacity}" Style="{StaticResource ModernSliderStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- ===================== Position ===================== -->
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Text Position" Style="{StaticResource SectionHeaderStyle}"/>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <UniformGrid Rows="3" Columns="3" Width="84" Height="84" VerticalAlignment="Top">
                                                <RadioButton GroupName="Anchor" Style="{StaticResource AnchorRadioButtonStyle}"
                                                             IsChecked="{Binding Design.TextAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=TopLeft}"/>
                                                <RadioButton GroupName="Anchor" Style="{StaticResource AnchorRadioButtonStyle}"
                                                             IsChecked="{Binding Design.TextAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=TopCenter}"/>
                                                <RadioButton GroupName="Anchor" Style="{StaticResource AnchorRadioButtonStyle}"
                                                             IsChecked="{Binding Design.TextAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=TopRight}"/>
                                                <RadioButton GroupName="Anchor" Style="{StaticResource AnchorRadioButtonStyle}"
                                                             IsChecked="{Binding Design.TextAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=MiddleLeft}"/>
                                                <RadioButton GroupName="Anchor" Style="{StaticResource AnchorRadioButtonStyle}"
                                                             IsChecked="{Binding Design.TextAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=MiddleCenter}"/>
                                                <RadioButton GroupName="Anchor" Style="{StaticResource AnchorRadioButtonStyle}"
                                                             IsChecked="{Binding Design.TextAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=MiddleRight}"/>
                                                <RadioButton GroupName="Anchor" Style="{StaticResource AnchorRadioButtonStyle}"
                                                             IsChecked="{Binding Design.TextAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=BottomLeft}"/>
                                                <RadioButton GroupName="Anchor" Style="{StaticResource AnchorRadioButtonStyle}"
                                                             IsChecked="{Binding Design.TextAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=BottomCenter}"/>
                                                <RadioButton GroupName="Anchor" Style="{StaticResource AnchorRadioButtonStyle}"
                                                             IsChecked="{Binding Design.TextAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=BottomRight}"/>
                                            </UniformGrid>

                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                                <TextBlock Text="Anchor the text to a corner, edge, or the center. The offset sliders below then nudge it inward from whichever edges are active."
                                                           Style="{StaticResource HintTextStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Style="{StaticResource SliderLabelRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="HORIZONTAL OFFSET" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Design.OffsetX, StringFormat={}{0:F0}px}" Style="{StaticResource FieldValueStyle}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding Design.OffsetX}" Style="{StaticResource ModernSliderStyle}" Margin="0,0,0,10"/>

                                        <Grid Style="{StaticResource SliderLabelRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="VERTICAL OFFSET" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Design.OffsetY, StringFormat={}{0:F0}px}" Style="{StaticResource FieldValueStyle}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding Design.OffsetY}" Style="{StaticResource ModernSliderStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- ===================== Background ===================== -->
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Background" Style="{StaticResource SectionHeaderStyle}"/>

                                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
                                            <RadioButton GroupName="BgType" Content="Solid" Style="{StaticResource SegmentRadioButtonStyle}"
                                                         IsChecked="{Binding Design.BackgroundType, Converter={StaticResource EnumToBool}, ConverterParameter=Solid}"/>
                                            <RadioButton GroupName="BgType" Content="Linear" Style="{StaticResource SegmentRadioButtonStyle}"
                                                         IsChecked="{Binding Design.BackgroundType, Converter={StaticResource EnumToBool}, ConverterParameter=LinearGradient}"/>
                                            <RadioButton GroupName="BgType" Content="Radial" Style="{StaticResource SegmentRadioButtonStyle}"
                                                         IsChecked="{Binding Design.BackgroundType, Converter={StaticResource EnumToBool}, ConverterParameter=RadialGradient}"/>
                                            <RadioButton GroupName="BgType" Content="Image" Style="{StaticResource SegmentRadioButtonStyle}"
                                                         IsChecked="{Binding Design.BackgroundType, Converter={StaticResource EnumToBool}, ConverterParameter=Image}"/>
                                        </UniformGrid>

                                        <!-- Solid -->
                                        <Grid Margin="0,0,0,4" Visibility="{Binding Design.BackgroundType, Converter={StaticResource EnumToVis}, ConverterParameter=Solid}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Color" Style="{StaticResource RowLabelStyle}"/>
                                            <controls:ColorPickerButton Grid.Column="1" SelectedColor="{Binding Design.BackgroundColor1}"/>
                                        </Grid>

                                        <!-- Gradients -->
                                        <StackPanel Visibility="{Binding Design.BackgroundType, Converter={StaticResource EnumToVis}, ConverterParameter='LinearGradient,RadialGradient'}">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Color 1" Style="{StaticResource RowLabelStyle}"/>
                                                <controls:ColorPickerButton Grid.Column="1" SelectedColor="{Binding Design.BackgroundColor1}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Color 2" Style="{StaticResource RowLabelStyle}"/>
                                                <controls:ColorPickerButton Grid.Column="1" SelectedColor="{Binding Design.BackgroundColor2}"/>
                                            </Grid>

                                            <StackPanel Visibility="{Binding Design.BackgroundType, Converter={StaticResource EnumToVis}, ConverterParameter=LinearGradient}">
                                                <Grid Style="{StaticResource SliderLabelRowStyle}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="GRADIENT ANGLE" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Design.GradientAngle, StringFormat={}{0:F0}°}" Style="{StaticResource FieldValueStyle}"/>
                                                </Grid>
                                                <Slider Minimum="0" Maximum="360" Value="{Binding Design.GradientAngle}" Style="{StaticResource ModernSliderStyle}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Image -->
                                        <StackPanel Visibility="{Binding Design.BackgroundType, Converter={StaticResource EnumToVis}, ConverterParameter=Image}">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Design.BackgroundImagePath}" Style="{StaticResource HintTextStyle}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Content="Choose…" Style="{StaticResource SecondaryButtonStyle}" Padding="10,6" FontSize="12"
                                                        Command="{Binding BrowseBackgroundImageCommand}" Margin="0,0,6,0"/>
                                                <Button Grid.Column="2" Content="Clear" Style="{StaticResource GhostIconButtonStyle}" Padding="8,6" FontSize="12"
                                                        Command="{Binding ClearBackgroundImageCommand}"/>
                                            </Grid>

                                            <TextBlock Text="FIT" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                            <UniformGrid Rows="1" Columns="3">
                                                <RadioButton GroupName="Stretch" Content="Fill" Style="{StaticResource SegmentRadioButtonStyle}"
                                                             IsChecked="{Binding Design.BackgroundImageStretch, Converter={StaticResource EnumToBool}, ConverterParameter=UniformToFill}"/>
                                                <RadioButton GroupName="Stretch" Content="Fit" Style="{StaticResource SegmentRadioButtonStyle}"
                                                             IsChecked="{Binding Design.BackgroundImageStretch, Converter={StaticResource EnumToBool}, ConverterParameter=Uniform}"/>
                                                <RadioButton GroupName="Stretch" Content="Stretch" Style="{StaticResource SegmentRadioButtonStyle}"
                                                             IsChecked="{Binding Design.BackgroundImageStretch, Converter={StaticResource EnumToBool}, ConverterParameter=Fill}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ===================== Shape ===================== -->
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Shape" Style="{StaticResource SectionHeaderStyle}"/>

                                        <Grid Style="{StaticResource SliderLabelRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CORNER RADIUS" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Design.CornerRadius, StringFormat={}{0:F0}px}" Style="{StaticResource FieldValueStyle}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="128" Value="{Binding Design.CornerRadius}" Style="{StaticResource ModernSliderStyle}" Margin="0,0,0,10"/>

                                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,14">
                                            <Button Content="Square" Style="{StaticResource SecondaryButtonStyle}" Padding="6,7" FontSize="11.5" Margin="0,0,4,0"
                                                    Command="{Binding CornerRadiusPresetCommand}" CommandParameter="0"/>
                                            <Button Content="Rounded" Style="{StaticResource SecondaryButtonStyle}" Padding="6,7" FontSize="11.5" Margin="0,0,4,0"
                                                    Command="{Binding CornerRadiusPresetCommand}" CommandParameter="40"/>
                                            <Button Content="Squircle" Style="{StaticResource SecondaryButtonStyle}" Padding="6,7" FontSize="11.5" Margin="0,0,4,0"
                                                    Command="{Binding CornerRadiusPresetCommand}" CommandParameter="76"/>
                                            <Button Content="Circle" Style="{StaticResource SecondaryButtonStyle}" Padding="6,7" FontSize="11.5"
                                                    Command="{Binding CornerRadiusPresetCommand}" CommandParameter="128"/>
                                        </UniformGrid>

                                        <Grid Style="{StaticResource SwitchRowStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Border stroke" Style="{StaticResource RowLabelStyle}"/>
                                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding Design.ShowBorder}"/>
                                        </Grid>

                                        <StackPanel Visibility="{Binding Design.ShowBorder, Converter={StaticResource BoolToVis}}">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Border color" Style="{StaticResource RowLabelStyle}"/>
                                                <controls:ColorPickerButton Grid.Column="1" SelectedColor="{Binding Design.BorderColor}"/>
                                            </Grid>
                                            <Grid Style="{StaticResource SliderLabelRowStyle}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="BORDER WIDTH" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Design.BorderWidth, StringFormat={}{0:F0}px}" Style="{StaticResource FieldValueStyle}"/>
                                            </Grid>
                                            <Slider Minimum="1" Maximum="24" Value="{Binding Design.BorderWidth}" Style="{StaticResource ModernSliderStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ===================== Text shadow ===================== -->
                                <Border Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <Grid Style="{StaticResource SwitchRowStyle}" Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Text Shadow" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                                            <CheckBox Grid.Column="1" Style="{StaticResource SwitchToggleStyle}" IsChecked="{Binding Design.ShowShadow}"/>
                                        </Grid>

                                        <StackPanel Visibility="{Binding Design.ShowShadow, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Shadow color" Style="{StaticResource RowLabelStyle}"/>
                                                <controls:ColorPickerButton Grid.Column="1" SelectedColor="{Binding Design.ShadowColor}"/>
                                            </Grid>

                                            <Grid Style="{StaticResource SliderLabelRowStyle}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="BLUR" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Design.ShadowBlur, StringFormat={}{0:F0}px}" Style="{StaticResource FieldValueStyle}"/>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="60" Value="{Binding Design.ShadowBlur}" Style="{StaticResource ModernSliderStyle}" Margin="0,0,0,10"/>

                                            <Grid Style="{StaticResource SliderLabelRowStyle}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="DEPTH" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Design.ShadowDepth, StringFormat={}{0:F0}px}" Style="{StaticResource FieldValueStyle}"/>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="30" Value="{Binding Design.ShadowDepth}" Style="{StaticResource ModernSliderStyle}" Margin="0,0,0,10"/>

                                            <Grid Style="{StaticResource SliderLabelRowStyle}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="DIRECTION" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Design.ShadowDirection, StringFormat={}{0:F0}°}" Style="{StaticResource FieldValueStyle}"/>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="360" Value="{Binding Design.ShadowDirection}" Style="{StaticResource ModernSliderStyle}" Margin="0,0,0,10"/>

                                            <Grid Style="{StaticResource SliderLabelRowStyle}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="OPACITY" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Design.ShadowOpacity, StringFormat={}{0:P0}}" Style="{StaticResource FieldValueStyle}"/>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" Value="{Binding Design.ShadowOpacity}" Style="{StaticResource ModernSliderStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ===================== Export ===================== -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="Export" Style="{StaticResource SectionHeaderStyle}"/>

                                        <TextBlock Text="FILE NAME" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>

                                        <TextBlock Text="OUTPUT FOLDER (used for PNG export)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding OutputFolder}" Style="{StaticResource DarkTextBoxStyle}" IsReadOnly="True" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButtonStyle}" Padding="10,7" FontSize="12"
                                                    Command="{Binding BrowseOutputFolderCommand}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="Open" Style="{StaticResource GhostIconButtonStyle}" Padding="8,7" FontSize="12"
                                                    Command="{Binding OpenOutputFolderCommand}"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SIZES TO INCLUDE" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="All" Style="{StaticResource GhostIconButtonStyle}" Padding="6,2" FontSize="11"
                                                        Command="{Binding SelectAllSizesCommand}" Margin="0,0,4,0"/>
                                                <Button Content="None" Style="{StaticResource GhostIconButtonStyle}" Padding="6,2" FontSize="11"
                                                        Command="{Binding SelectNoneSizesCommand}"/>
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Sizes}" Margin="0,0,0,16">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                                              Style="{StaticResource SizeCheckBoxStyle}" Margin="0,0,8,8"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="Export .ICO…" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                                Command="{Binding ExportIcoCommand}" Margin="0,0,0,8"/>
                                        <Button Content="Export as PNG files" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch"
                                                Command="{Binding ExportPngCommand}" Margin="0,0,0,8"/>
                                        <Button Content="Copy 256×256 PNG to clipboard" Style="{StaticResource GhostIconButtonStyle}" HorizontalAlignment="Stretch"
                                                Command="{Binding CopyToClipboardCommand}" Margin="0,0,0,4"/>

                                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource HintTextStyle}"
                                                   Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"
                                                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ========== Right: preview ========== -->
                <Grid Grid.Column="1" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preview" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <UniformGrid Rows="1" Columns="3" Margin="0,0,12,0">
                                <RadioButton GroupName="Backdrop" Content="Transparent" Style="{StaticResource SegmentRadioButtonStyle}" FontSize="11.5" Padding="8,6"
                                             IsChecked="{Binding PreviewBackdrop, Converter={StaticResource EnumToBool}, ConverterParameter=Checkered}"/>
                                <RadioButton GroupName="Backdrop" Content="Light" Style="{StaticResource SegmentRadioButtonStyle}" FontSize="11.5" Padding="8,6"
                                             IsChecked="{Binding PreviewBackdrop, Converter={StaticResource EnumToBool}, ConverterParameter=Light}"/>
                                <RadioButton GroupName="Backdrop" Content="Dark" Style="{StaticResource SegmentRadioButtonStyle}" FontSize="11.5" Padding="8,6"
                                             IsChecked="{Binding PreviewBackdrop, Converter={StaticResource EnumToBool}, ConverterParameter=Dark}"/>
                            </UniformGrid>

                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" Width="96"
                                      ItemsSource="{Binding PreviewZoomLevels}" SelectedItem="{Binding PreviewZoom}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0}px}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{Binding PreviewBackdrop, Converter={StaticResource BackdropToBrush}}"
                            CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="28">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="30" ShadowDepth="8"/>
                        </Border.Effect>
                        <Image Source="{Binding PreviewImage}" Width="{Binding PreviewZoom}" Height="{Binding PreviewZoom}"
                               Stretch="None" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Actual size reference" Style="{StaticResource SectionHeaderStyle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                <StackPanel Margin="14,0" HorizontalAlignment="Center">
                                    <Border Width="56" Height="56" CornerRadius="8"
                                            Background="{Binding PreviewBackdrop, Converter={StaticResource BackdropToBrush}}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding Thumb16}" Width="16" Height="16" Stretch="None"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                    </Border>
                                    <TextBlock Text="16×16" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <StackPanel Margin="14,0" HorizontalAlignment="Center">
                                    <Border Width="56" Height="56" CornerRadius="8"
                                            Background="{Binding PreviewBackdrop, Converter={StaticResource BackdropToBrush}}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding Thumb32}" Width="32" Height="32" Stretch="None"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                    </Border>
                                    <TextBlock Text="32×32" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <StackPanel Margin="14,0" HorizontalAlignment="Center">
                                    <Border Width="56" Height="56" CornerRadius="8"
                                            Background="{Binding PreviewBackdrop, Converter={StaticResource BackdropToBrush}}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding Thumb48}" Width="48" Height="48" Stretch="None"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                    </Border>
                                    <TextBlock Text="48×48" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <StackPanel Margin="14,0" HorizontalAlignment="Center">
                                    <Border Width="56" Height="56" CornerRadius="8"
                                            Background="{Binding PreviewBackdrop, Converter={StaticResource BackdropToBrush}}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Image Source="{Binding Thumb256}" Width="52" Height="52" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                    </Border>
                                    <TextBlock Text="256×256" Style="{StaticResource HintTextStyle}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
